{
  "name": "dsh-todo-list",
  "version": "0.2.0",
  "description": "A per-project todo checklist in the DeepSeek Harness right sidebar: create, check off, edit and delete tasks, keep them in a git-tracked `.todo.md` at the project root, and send the list to the current AI session for requirement analysis.",
  "type": "module",
  "license": "MIT",
  "author": "bgmmd",
  "homepage": "https://github.com/bgmmd/dsh-todo-list",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgmmd/dsh-todo-list.git"
  },
  "bugs": {
    "url": "https://github.com/bgmmd/dsh-todo-list/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "todo",
    "todo-list",
    "checklist",
    "right-sidebar",
    "git"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
